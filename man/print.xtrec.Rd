\name{print.xtrec}
\alias{print.xtrec}
\title{Print Method for xtrec Objects}
\description{Prints a formatted summary of an \code{"xtrec"} test result.}
\usage{
\method{print}{xtrec}(x, \dots)
}
\arguments{
  \item{x}{An object of class \code{"xtrec"}.}
  \item{\dots}{Additional arguments (ignored).}
}
\value{Invisibly returns \code{x}.}
\keyword{print}
